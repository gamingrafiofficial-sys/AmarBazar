rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous' || request.auth.token.email == 'gamingrafi.official@gmail.com');
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gamingrafi.official@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper: User validation
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['customer', 'shopkeeper', 'rider', 'admin'] &&
             data.isActive is bool;
    }

    // Helper: Product validation
    function isValidProduct(data) {
      return data.id is string && isValidId(data.id) &&
             data.shopId is string && isValidId(data.shopId) &&
             data.marketId is string && isValidId(data.marketId) &&
             data.nameEn is string && data.nameEn.size() > 0 && data.nameEn.size() <= 150 &&
             data.nameBn is string && data.nameBn.size() > 0 && data.nameBn.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.unit in ['kg', 'gm', 'litre', 'ml', 'piece', 'dozen', 'pack', 'bundle'] &&
             data.stock is number && data.stock >= 0 &&
             data.isAvailable is bool;
    }

    // Helper: Order validation
    function isValidOrder(data) {
      return data.id is string && isValidId(data.id) &&
             data.customerId is string && data.customerId == request.auth.uid &&
             data.shopId is string && isValidId(data.shopId) &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.deliveryFee is number && data.deliveryFee >= 0 &&
             data.totalAmount is number && data.totalAmount >= data.subtotal &&
             data.roadDistanceKm is number && data.roadDistanceKm >= 0 &&
             data.paymentMethod == 'cod' &&
             data.paymentStatus in ['pending', 'collected', 'deposited', 'failed'] &&
             data.orderStatus in [
               'pending_shop_confirmation', 'shop_confirmed', 'shop_rejected',
               'rider_assigned', 'picked_up', 'out_for_delivery', 'delivered',
               'delivery_failed', 'cancelled', 'returned'
             ] &&
             data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 500;
    }

    // --- CUSTOMERS COLLECTION ---
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // --- RIDERS COLLECTION ---
    match /riders/{riderId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    incoming().role == 'customer'; // Default role on client creation; other roles promoted by admin
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          isValidUser(incoming()) &&
          incoming().role == existing().role && // Prevent self-elevation
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'defaultAddress', 'marketId', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- MARKETS COLLECTION ---
    match /markets/{marketId} {
      allow get, list: if true; // Public directory of service hubs
      allow write: if true;
    }

    // --- SHOPS COLLECTION ---
    match /shops/{shopId} {
      allow get, list: if true; // Public directory of approved shops
      allow create: if isSignedIn() && isValidId(shopId) && (isAdmin() || incoming().ownerId == request.auth.uid);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().isApproved == existing().isApproved && // Shopkeeper cannot approve themselves
          incoming().diff(existing()).affectedKeys().hasOnly([
            'nameEn', 'nameBn', 'category', 'addressEn', 'addressBn',
            'phone', 'openingTime', 'closingTime', 'isOpen', 'image', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // --- CATEGORIES COLLECTION ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if true;
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow get, list: if true; // Public catalog browsing
      allow write: if true;
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- DELIVERIES COLLECTION ---
    match /deliveries/{deliveryId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- DELIVERY PRICING COLLECTION ---
    match /deliveryPricing/{pricingId} {
      allow get, list: if true; // Publicly readable for transparent fee formula
      allow write: if true;
    }

    // --- LEDGER ENTRIES COLLECTION (IMMUTABLE) ---
    match /ledgerEntries/{ledgerId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false; // Strict Immutability!
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    // --- DEPOSIT REQUESTS COLLECTION ---
    match /deposit_requests/{requestId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
