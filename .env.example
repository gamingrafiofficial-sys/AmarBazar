# ==========================================
# AmarBazaar - Environment Variables Template
# ==========================================

# 1. Environment & Server
NODE_ENV="production"
PORT=3000
APP_URL="https://your-domain.vercel.app"

# 2. Database - PostgreSQL (Cloud SQL / Supabase / Neon)
SQL_HOST="your-postgres-host-or-ip"
SQL_USER="postgres-user"
SQL_PASSWORD="your-strong-password"
SQL_DB_NAME="your-database-name"
SQL_ADMIN_USER="postgres-admin-user"
SQL_ADMIN_PASSWORD="admin-password"

# 3. Google Maps API (Optional: For live road routing and distance)
# Leave blank to use built-in calibrated urban route model for Bangladesh
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# 4. Gemini AI API (Optional)
GEMINI_API_KEY="your-gemini-api-key"
